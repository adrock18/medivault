PORT=3001
HOST=127.0.0.1
COOKIE_SECURE=false
NODE_ENV=development
# For production behind HTTPS: NODE_ENV=production, COOKIE_SECURE=true
# APP_ORIGIN=https://your-app.example.com
# Hosted deployments behind a reverse proxy (Render uses 1 hop):
# TRUST_PROXY=1
# Supabase server configuration (required by the managed backend).
# APP_ORIGIN=http://127.0.0.1:5187
# SUPABASE_URL must be the project root URL, without /rest/v1.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DOCUMENT_BUCKET=medical-records
# Optional remote OCR. Only use with explicit per-scan consent; the free tier
# is not covered by a signed DPA and must not receive real medical documents.
# OCR_SPACE_API_KEY=
# Optional email reminders. Set all three only after configuring Resend and an
# external scheduler for POST /api/internal/reminders.
# RESEND_API_KEY=
# EMAIL_FROM=
# REMINDER_CRON_SECRET=use-a-random-secret-at-least-32-characters-long
