PORT=3001
HOST=127.0.0.1
DATA_DIR=.\data
COOKIE_SECURE=false
NODE_ENV=development
# For production behind HTTPS: NODE_ENV=production, COOKIE_SECURE=true
# APP_ORIGIN=https://your-app.example.com
# Hosted deployments behind a reverse proxy (Render uses 1 hop):
# TRUST_PROXY=1
# Document storage: local (default, DATA_DIR/documents) or s3 (private S3-compatible bucket).
# DOCUMENT_STORAGE=s3
# S3_ENDPOINT=https://s3.<region>.backblazeb2.com
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Container only: replicate the SQLite database to this key prefix in S3_BUCKET with Litestream.
# LITESTREAM_REPLICA_PATH=db
